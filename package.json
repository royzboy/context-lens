{
  "name": "context-lens",
  "displayName": "Context Lens",
  "description": "AI context visibility and context hygiene for developers",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:contextLens.panel"
],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "context-lens.helloWorld",
      "title": "Hello World"
    }
  ],
  "viewsContainers": {
  "activitybar": [
    {
      "id": "contextLens",
      "title": "Context Lens",
      "icon": "resources/context-lens.svg"
    }
  ]
},
  "views": {
  "contextLens": [
    {
      "type": "webview",
      "id": "contextLens.panel",
      "name": "Context"
    }
  ]
}
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
